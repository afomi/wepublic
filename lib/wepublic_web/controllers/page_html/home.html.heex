<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-gradient-to-br from-base-300 via-base-200 to-base-300">
  <div class="hero min-h-screen">
    <div class="hero-content text-center">
      <div class="max-w-2xl">
        <div class="flex justify-center mb-8">
          <div class="w-24 h-24 rounded-full bg-primary/20 flex items-center justify-center">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              class="w-14 h-14 text-primary">
              <circle
                cx="12"
                cy="12"
                r="10" />
              <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
          </div>
        </div>

        <h1 class="text-5xl font-bold tracking-tight">
          Wepublic
        </h1>

        <p class="py-6 text-xl text-base-content/80 leading-relaxed">
          A shared 3D canvas where people with public web identities
          can explore, connect, and shape the digital representation of our world.
        </p>

        <div class="divider divider-neutral max-w-xs mx-auto opacity-50"></div>

        <p class="text-sm text-base-content/60 mb-8 italic">
          Inspired by Stafford Beer's vision of "cyberfolk" -
          a populace linked into governance via real-time feedback,
          keeping workers, managers, and policymakers in the same loop
          without centralizing control.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={~p"/map"}
            class="btn btn-primary btn-lg gap-2">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="w-5 h-5">
              <path d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
            Enter the Map
          </a>
          <a
            href={~p"/users/log-in"}
            class="btn btn-outline btn-lg gap-2">
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-5 h-5">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 0C5.37 0 0 5.506 0 12.303c0 5.445 3.435 10.043 8.205 11.674.6.107.825-.262.825-.585 0-.292-.015-1.261-.015-2.291C6 21.67 5.22 20.346 4.98 19.654c-.135-.354-.72-1.446-1.23-1.738-.42-.23-1.02-.8-.015-.815.945-.015 1.62.892 1.845 1.261 1.08 1.86 2.805 1.338 3.495 1.015.105-.8.42-1.338.765-1.645-2.67-.308-5.46-1.37-5.46-6.075 0-1.338.465-2.446 1.23-3.307-.12-.308-.54-1.569.12-3.26 0 0 1.005-.323 3.3 1.26.96-.276 1.98-.415 3-.415s2.04.139 3 .416c2.295-1.6 3.3-1.261 3.3-1.261.66 1.691.24 2.952.12 3.26.765.861 1.23 1.953 1.23 3.307 0 4.721-2.805 5.767-5.475 6.075.435.384.81 1.122.81 2.276 0 1.645-.015 2.968-.015 3.383 0 .323.225.707.825.585a12.047 12.047 0 0 0 5.919-4.489A12.536 12.536 0 0 0 24 12.304C24 5.505 18.63 0 12 0Z" />
            </svg>
            Sign In with GitHub
          </a>
        </div>

        <div class="mt-16 grid grid-cols-1 sm:grid-cols-3 gap-6 text-left">
          <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
              <div class="text-primary mb-2">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="w-8 h-8">
                  <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <h3 class="card-title text-base">
                Earth Space
              </h3>
              <p class="text-sm text-base-content/70">
                Navigate a 3D isometric view of real-world locations.
                Properties, vehicles, and civic data rendered in shared space.
              </p>
            </div>
          </div>

          <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
              <div class="text-primary mb-2">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="w-8 h-8">
                  <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <h3 class="card-title text-base">
                Web Identity
              </h3>
              <p class="text-sm text-base-content/70">
                Your public presence, verified by your own website or DID.
                Connect with others while maintaining ownership of your identity.
              </p>
            </div>
          </div>

          <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
              <div class="text-primary mb-2">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="w-8 h-8">
                  <path d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="card-title text-base">
                Open Data
              </h3>
              <p class="text-sm text-base-content/70">
                Visualize civic data catalogs, jurisdictional boundaries,
                and community information with time scrubbing and layers.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-12 text-sm text-base-content/50">
          <Layouts.theme_toggle />
        </div>
      </div>
    </div>
  </div>
</div>
